# Trusty core
TRUSTY_HOME=/home/pi/trusty
TRUSTY_HOST=0.0.0.0
TRUSTY_PORT=8090
TRUSTY_MODE=online

# llama.cpp + Gemma 4 (Pi default: Q4_K_S, ~2.83 GB; Mac default: Q6_K)
# Allowed GEMMA_QUANT: Q8_0 | Q6_K | Q5_K_M | Q4_K_M | Q4_K_S
LLAMA_CPP_DIR=${TRUSTY_HOME}/external/llama.cpp
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
GEMMA_QUANT=Q4_K_S
GEMMA_MODEL_PATH=${TRUSTY_HOME}/models/gemma/gemma-4-e2b-it-q4_k_s.gguf

# llama.cpp tuning (per-host overrides). Defaults in scripts/run_llama_server.sh
# are safe for any host; values below are tuned for Pi 5 (8 GB).
# Decode threads (memory-bound). Pi 5: 3 leaves core 3 for runner/voice.
LLAMA_THREADS=3
# Prefill threads (compute-bound). Pi 5: 4 uses all cores during prompt
# processing, then drops back to 3 for decode so voice/runner stay smooth.
LLAMA_THREADS_BATCH=4
# Context window. 4096 holds the planner system prompt + tools + recents
# with headroom. Lower to 3072 or 2048 only if you trim the prompt.
LLAMA_CTX_SIZE=4096
# KV cache quantization. q8_0 halves KV bandwidth on decode (5-10% faster
# on Pi 5) at effectively no quality loss. Set to f16 to revert.
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
# Parallel sequence slots. Recent llama.cpp builds default this above 1
# and split the KV cache, overflowing our ~3000-token planner prompt.
# Keep at 1 unless you actually need concurrent /chat requests.
LLAMA_PARALLEL=1
# Pin model pages in RAM. Recommended on Pi 5 if Docker (HA + MA) bursts
# memory: avoids paging the model under pressure. 0 = off, 1 = on.
LLAMA_MLOCK=0
# Flash attention. Mostly a GPU flag, marginal on ARM CPU. 0 = off, 1 = on.
LLAMA_FLASH_ATTN=0
# CPU affinity for llama-server (taskset -c). Empty = no pinning.
# Pi 5 demo: "0-2" pins llama to cores 0-2 and frees core 3 for the runner
# and voice loop. Leave empty on Mac and older Pis.
LLAMA_CPU_AFFINITY=

# Hugging Face token (only needed once, for scripts/download_models.sh)
HF_TOKEN=

# Wake word: custom model (tflite) runs alongside the built-in (hey_jarvis).
WAKEWORD_NAME=hey_trusty
WAKEWORD_MODEL_NAME=hey_jarvis
WAKEWORD_MODEL_PATH=${TRUSTY_HOME}/models/wakeword/hey_trusty.tflite
WAKEWORD_THRESHOLD=0.5
WAKEWORD_THRESHOLD_BUILTIN=0.6
# WAKEWORD_MODE: OFF (default) skips openWakeWord and scans the STT
# transcript for "trusty"/"wake up", so users do not need to train a
# custom hey_trusty.tflite to try the project. Set to ON once you have
# trained your own model (see WAKE_WORD.md). Sleep/wake/music unchanged.
WAKEWORD_MODE=OFF

# Speech to text (moonshine default, ~3x faster on Pi 5 than whisper)
STT_BACKEND=moonshine
MOONSHINE_MODEL=base

# Air-gap Hugging Face at runtime (safe once models are on disk)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# Whisper fallback. Pair the Whisper model with the Gemma quant:
#   Q8_0 -> small.en, otherwise base.en
WHISPER_CPP_DIR=${TRUSTY_HOME}/external/whisper.cpp
WHISPER_BIN=${WHISPER_CPP_DIR}/build/bin/whisper-cli
WHISPER_MODEL_PATH=${TRUSTY_HOME}/models/whisper/ggml-base.en.bin

# Kokoro TTS
KOKORO_MODEL_PATH=${TRUSTY_HOME}/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=${TRUSTY_HOME}/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart
KOKORO_LANG=en-us
KOKORO_SPEED=1.0

# Home Assistant (optional: fill HA_TOKEN after pairing a TV or vacuum)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
LG_TV_ENTITY_ID=media_player.lg_webos_tv
VACUUM_ENTITY_ID=vacuum.s6_pure

# Music
MUSIC_ASSISTANT_URL=http://localhost:8095
MUSIC_PLAYER_ID=media_player.lg_webos_tv
LOCAL_MUSIC_DIR=${TRUSTY_HOME}/music

# Search
SEARXNG_URL=http://localhost:8088

# Eyes UI
EYES_ENABLED=true
EYES_PORT=8091
