[Unit]
Description=Trusty - llama.cpp server (Gemma 4 E2B IT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/trusty
EnvironmentFile=/home/pi/trusty/.env
ExecStart=/home/pi/trusty/scripts/run_llama_server.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
