# Secrets
.env
secrets.env
*.pem
*.key

# Models — large weights are downloaded by scripts/download_models.sh.
# Default: ignore everything under models/. Then re-include the few small
# models we ship in the repo so a fresh clone has wake-word + VAD ready
# without an extra download step. To re-include a file inside an ignored
# directory, the directory itself must be re-included first.
models/*
!models/vad/
models/vad/*
!models/vad/silero_vad.onnx
!models/wakeword/
models/wakeword/*
!models/wakeword/hey_trusty.tflite
!models/wakeword/hey_trusty.onnx

# External cloned repos (built locally; rebuilt on Pi)
external/*/build/
external/*/.cache/

# Privacy ledger and runtime data
data/
*.jsonl
*.wav
*.mp3
!music/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS / AI-tool footprints — keep local only
.DS_Store
.idea/
.vscode/
.claude/
.antigravity/
.gemini/
.google/
.idx/
.aiplatform/
*.swp

# Node (if anyone runs UI tooling)
node_modules/

# Third-party clones, container volumes — never commit
external/
.docker/
ahmad_pi.html

# Local photo album (user uploads via admin panel)
photos/*
!photos/.gitkeep
.env.bak
.env.backup-q6k
improve.md
screen.md

